{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/safety-redline-guard.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/evidence-before-pass-gate.mjs\" --phase pre"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/speak-before-act-hook.mjs\" --phase pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|View|read_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/evidence-before-pass-gate.mjs\" --phase post"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/speak-before-act-hook.mjs\" --phase stop"
          }
        ]
      }
    ]
  }
}
